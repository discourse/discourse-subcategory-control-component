{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "2.43.0",
    "eslint": "9.39.2",
    "prettier": "3.8.1"
  },
  "scripts": {
    "lint:js": "eslint javascripts --cache --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint javascripts --fix --no-error-on-unmatched-pattern",
    "lint:prettier": "prettier \"javascripts/**/*.js\" --check --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "prettier \"javascripts/**/*.js\" -w --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0"
}
